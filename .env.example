# ==============================================================================
# Environment Configuration Template for Automotive MEC Gateway & oneM2M Edge Middleware
# Software-Defined Vehicle (SDV) Cabin Environmental Monitoring
# Copy this template to .env and configure IP addresses and secrets prior to running.
# ==============================================================================

# ------------------------------------------------------------------------------
# Deployment Mode & Target Topology Selection
# ------------------------------------------------------------------------------
# DEPLOY_TARGET selects the operational deployment topology:
#   - 'localhost': Co-located single-host topology for local development,
#                  simulation, testing, and continuous integration.
#                  All components bind and communicate over 127.0.0.1 / localhost.
#   - 'remote'   : Distributed two-host topology where Module 1 and Module 2
#                  reside on separate physical/virtual hosts identified by their
#                  respective hostnames or IP addresses.
DEPLOY_TARGET=localhost

# ------------------------------------------------------------------------------
# Module 1: Base CSE Infrastructure Host (Singleton on Central Server / VM)
# ------------------------------------------------------------------------------
# Identifies the central server / virtual machine running ACME oneM2M IN-CSE,
# Mosquitto, InfluxDB, Grafana, and Bridge AE.
# Localhost mode : localhost (or 127.0.0.1)
# Remote mode    : Hostname or IPv4/IPv6 address (e.g. 192.168.122.91 or base-cse.sdv.local)
BASE_CSE_HOST=localhost
# Remote Server / VM Examples (uncomment for remote deployment):
# BASE_CSE_HOST=192.168.122.91
# BASE_CSE_HOST=base-cse.sdv.cluster.local

# ------------------------------------------------------------------------------
# Module 2: Vehicle AE Host (Multi-Instance In-Vehicle Raspberry Pi 5)
# ------------------------------------------------------------------------------
# Identifies the remote or local host executing the vehicular Application Entity,
# interfacing with in-cabin ESP32-S3 sensor instrumentation.
# Localhost mode : localhost (or 127.0.0.1)
# Remote mode    : Hostname or IPv4/IPv6 address of the specific vehicle SBC
#                  (e.g. 192.168.122.105 or rpi5-car01.sdv.vehicle.local)
VEHICLE_AE_HOST=localhost
# Remote In-Vehicle Raspberry Pi 5 Examples (uncomment for remote deployment):
# VEHICLE_AE_HOST=192.168.122.105
# VEHICLE_AE_HOST=rpi5-car01.sdv.vehicle.local

# ------------------------------------------------------------------------------
# Core Service Addressing (Derived from BASE_CSE_HOST for Module 1)
# ------------------------------------------------------------------------------
GATEWAY_IP=localhost
CSE_HOST=localhost
MQTT_HOST=localhost
INFLUXDB_HOST=localhost

# ------------------------------------------------------------------------------
# Service Port Allocations
# ------------------------------------------------------------------------------
ONEM2M_PORT=8080
MOSQUITTO_PORT=8883
MOSQUITTO_PLAIN_PORT=1883
INFLUXDB_HOST_PORT=8087
INFLUXDB_INTERNAL_PORT=8086
GRAFANA_PORT=3000
BRIDGE_AE_PORT=5000
WEB_PORTAL_PORT=8000

# ------------------------------------------------------------------------------
# oneM2M Common Services Entity (IN-CSE)
# ------------------------------------------------------------------------------
ONEM2M_CSE_ID=id-sdv
ONEM2M_CSE_NAME=sdv-cse
ONEM2M_ADMIN_ORIGIN=CAdmin
ONEM2M_RVI=3

# Target oneM2M Endpoints (Loaded dynamically from environment)
BASE_URL=http://localhost:8080
NOTIFICATION_BASE_URL=http://localhost:8080
DOWNLINK_NOTIFICATION_URL=http://localhost:8080/downlink

# ------------------------------------------------------------------------------
# Eclipse Mosquitto MQTT Broker
# ------------------------------------------------------------------------------
MOSQUITTO_DATA_DIR=./deploy/mosquitto/data

# ------------------------------------------------------------------------------
# InfluxDB 2.x Time-Series Database
# ------------------------------------------------------------------------------
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=ChangeThisPasswordPriorToDeploy!
DOCKER_INFLUXDB_INIT_ORG=fhtw_aiot
DOCKER_INFLUXDB_INIT_BUCKET=cabin_telemetry
DOCKER_INFLUXDB_INIT_RETENTION=30d
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=ChangeThisToAStrongGeneratedSecretToken==

# ------------------------------------------------------------------------------
# Grafana Operations Cockpit
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeThisGrafanaPasswordPriorToDeploy!

# ------------------------------------------------------------------------------
# Bridge AE & Health State Machine Heuristics
# ------------------------------------------------------------------------------
BRIDGE_AE_EVAL_MAX_LATENCY_S=2.5
BRIDGE_AE_MAX_DELTA_T_C=1.5

# ------------------------------------------------------------------------------
# Web Portal Operations Dashboard
# ------------------------------------------------------------------------------
WEB_PORTAL_SECRET_KEY=sdv-dev-portal-secret-key
FLASK_DEBUG=false
