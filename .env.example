# ==============================================================================
# Environment Configuration Template for Automotive MEC Gateway & oneM2M Edge Middleware
# Software-Defined Vehicle (SDV) Cabin Environmental Monitoring
# Copy this template to .env and configure IP addresses and secrets prior to running.
# ==============================================================================

# ------------------------------------------------------------------------------
# Network & Host Infrastructure
# ------------------------------------------------------------------------------
GATEWAY_IP=192.168.122.91
CSE_HOST=192.168.122.91
MQTT_HOST=192.168.122.91
INFLUXDB_HOST=192.168.122.91

# ------------------------------------------------------------------------------
# Service Port Allocations
# ------------------------------------------------------------------------------
ONEM2M_PORT=8080
MOSQUITTO_PORT=8883
MOSQUITTO_PLAIN_PORT=1883
INFLUXDB_HOST_PORT=8087
INFLUXDB_INTERNAL_PORT=8086
GRAFANA_PORT=3000
BRIDGE_AE_PORT=5000
WEB_PORTAL_PORT=8000

# ------------------------------------------------------------------------------
# oneM2M Common Services Entity (IN-CSE)
# ------------------------------------------------------------------------------
ONEM2M_CSE_ID=id-sdv
ONEM2M_CSE_NAME=sdv-cse
ONEM2M_ADMIN_ORIGIN=CAdmin
ONEM2M_RVI=3

# Target oneM2M Endpoints
BASE_URL=http://192.168.122.91:8080
NOTIFICATION_BASE_URL=http://192.168.122.91:8080
DOWNLINK_NOTIFICATION_URL=http://192.168.122.91:8080/downlink

# ------------------------------------------------------------------------------
# Eclipse Mosquitto MQTT Broker
# ------------------------------------------------------------------------------
MOSQUITTO_DATA_DIR=./deploy/mosquitto/data

# ------------------------------------------------------------------------------
# InfluxDB 2.x Time-Series Database
# ------------------------------------------------------------------------------
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=ChangeThisPasswordPriorToDeploy!
DOCKER_INFLUXDB_INIT_ORG=fhtw_aiot
DOCKER_INFLUXDB_INIT_BUCKET=cabin_telemetry
DOCKER_INFLUXDB_INIT_RETENTION=30d
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=ChangeThisToAStrongGeneratedSecretToken==

# ------------------------------------------------------------------------------
# Grafana Operations Cockpit
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeThisGrafanaPasswordPriorToDeploy!

# ------------------------------------------------------------------------------
# Bridge AE & Health State Machine Heuristics
# ------------------------------------------------------------------------------
BRIDGE_AE_EVAL_MAX_LATENCY_S=2.5
BRIDGE_AE_MAX_DELTA_T_C=1.5

# ------------------------------------------------------------------------------
# Web Portal Operations Dashboard
# ------------------------------------------------------------------------------
WEB_PORTAL_SECRET_KEY=sdv-dev-portal-secret-key
FLASK_DEBUG=false
