flowchart TD
    subgraph LEGACY ["Historical Federated Architecture (Legacy Automotive)"]
        direction LR
        S_LEG["Cabin Sensors"] -->|"CAN / LIN Bus"| ECU_LEG["Monolithic HVAC ECU<br/><i>(Closed Proprietary Firmware)</i>"]
        ECU_LEG -->|"Relays / Direct Wiring"| BLOW_LEG["Blower Fan / Heater Core"]
    end

    LEGACY ==>|"Automotive E/E Paradigm Transition to Modular Service-Oriented SDV"| SDV

    subgraph SDV ["Modern Modular Service-Oriented SDV Architecture (FHTW-AIOT)"]
        direction LR
        subgraph SENS ["Tier 1: Sensing &amp; Acquisition (ESP32-S3)"]
            direction TB
            SCD["Single Sensirion SCD30<br/><i>NDIR CO2, Temp &amp; RH (I2C, CRC-8)</i>"]
            ECU_IO["ESP32-S3 FreeRTOS Node<br/><i>UART 115200 • 25 kHz PWM • PCNT Tach</i>"]
            SCD --> ECU_IO
        end

        subgraph MOD2 ["Module 2: Vehicle AE (Raspberry Pi 5)"]
            direction TB
            EDGE_AE["Containerised Vehicle AE Services<br/>• sdv_edge_serial_client (Uplink)<br/>• sdv_actuator_module (Downlink)<br/><i>0 Open Ingress Ports • Outbound mTLS 1.3</i>"]
        end

        subgraph MOD1 ["Module 1: Base CSE Infrastructure (Server / VM)"]
            direction TB
            CSE["ACME oneM2M IN-CSE<br/><b>/sdv-cse</b> (Zero AEs at Boot • Baseline Governance)"]
            ACMES["ACMEScripts Engine<br/><i>Replaces Node-RED • Native TS-0010 &amp; Rules</i>"]
            HC["Data Health Classifier<br/><b>(FRESH / STALE / DEGRADED / FAULT)</b>"]
            CSE <--> ACMES
            CSE <--> HC
        end

        subgraph DOWNSTREAM ["Analytics &amp; Closed-Loop Actuation"]
            direction TB
            ACT["Closed-Loop Actuator Suite<br/>• 25 kHz PWM Purge Blower<br/>• Heat, Eco, Alert LEDs &amp; WS2812B"]
            OBS["Observability Cockpit<br/>• InfluxDB 2.7 Persistence<br/>• Grafana Enterprise &amp; Web Portal"]
        end

        SENS <-->|"UART"| MOD2
        MOD2 -->|"Mutual TLS 1.3 / TS-0010 MQTT &amp; Mca"| MOD1
        ACMES -->|"Downlink Directive"| MOD2
        MOD2 --> ACT
        MOD1 --> OBS
        ACT -.->|"Dynamic Environmental Feedback"| SENS
    end

    classDef legacy fill:#F1F5F9,stroke:#94A3B8,stroke-width:2px,color:#334155
    classDef sdv fill:#F8FAFC,stroke:#2563EB,stroke-width:2px,color:#0F172A
    classDef sensor fill:#ECFDF5,stroke:#10B981,stroke-width:1.5px,color:#064E3B
    classDef mod2 fill:#F0FDF4,stroke:#16A34A,stroke-width:1.5px,color:#14532D
    classDef cse fill:#EFF6FF,stroke:#2563EB,stroke-width:1.5px,color:#1E3A8A
    classDef act fill:#FEF2F2,stroke:#EF4444,stroke-width:1.5px,color:#7F1D1D
    classDef obs fill:#FFFBEB,stroke:#F59E0B,stroke-width:1.5px,color:#78350F

    class S_LEG,ECU_LEG,BLOW_LEG legacy
    class SCD,ECU_IO sensor
    class EDGE_AE mod2
    class CSE,ACMES,HC cse
    class ACT act
    class OBS obs
