flowchart LR
    subgraph TIER1 ["FIRMWARE TIER: Smart Cabin Micro-ECU (ESP32-S3)"]
        direction TB
        SENSORS["Single Sensirion SCD30 Sensor<br/><i>NDIR CO2, Temp &amp; RH over I2C (GPIO 8/9, CRC-8)</i>"]
        ESP["ESP32-S3 Micro-ECU<br/><i>FreeRTOS Dual-Core Firmware</i>"]
        ACTUATORS["Actuator LED Array &amp; Feedback<br/><i>Blue 25 kHz PWM Purge | Red Heat | Green Eco | Amber Alert | PCNT Tach</i>"]
        SENSORS --> ESP
        ESP --> ACTUATORS
    end

    subgraph MOD2 ["VEHICLE-BASED COMPONENTS: Module 2 Vehicle AE (Raspberry Pi 5 • 0 Open Ingress Ports)"]
        direction TB
        CLIENT["sdv_edge_serial_client<br/><i>Telemetry Ingestion AE (Outbound Only)</i>"]
        ACT_MOD["sdv_actuator_module<br/><i>Actuation Dispatcher AE (Outbound Only)</i>"]
        CERTS["Local PKI Trust Store<br/><i>ca.crt, client_esp32.crt, client_esp32.key</i>"]
    end

    subgraph MOD1 ["SERVER / NETWORK-BASED COMPONENTS: Module 1 Base CSE Infrastructure (Central Server / VM)"]
        direction TB
        MOSQ["Eclipse Mosquitto MQTT Broker<br/><i>mTLS 1.3 Termination (Port 8883) • Internal (1883)</i>"]
        CSE["ACME oneM2M IN-CSE (/sdv-cse, Port 8080)<br/><i>Zero AEs at Boot • Baseline Governance (acp_fleet_manager, grp_fleet_telemetry)</i>"]
        ACMES["ACMEScripts Engine (Built-in In-CSE)<br/><i>Replaces Node-RED IPE • Native TS-0010 MQTT Binding &amp; Rule Automation</i>"]
        BRIDGE["sdv_bridge_ae<br/><i>Health Classifier &amp; Telemetry Bridge (Port 5000)</i>"]
        INFLUX["InfluxDB 2.7<br/><i>cabin_telemetry TSDB (Port 8087:8086)</i>"]
        GRAF["Grafana Enterprise &amp; Web Portal<br/><i>Cockpit &amp; Fleet Admin (Ports 3000 &amp; 8000)</i>"]

        MOSQ <-->|"TS-0010 Native MQTT"| CSE
        CSE <--> ACMES
        CSE <--> BRIDGE
        BRIDGE --> INFLUX
        INFLUX --> GRAF
    end

    ESP ===>|"UART / USB Serial (115200 Baud)<br/>JSON Telemetry"| CLIENT
    ACT_MOD -.->|"UART Actuation Directives<br/>CMD:PWM=...,MODE=..."| ESP

    CLIENT ===>|"[Mode 1 Distributed] Outbound mTLS 1.3 (8883) &amp; Mca HTTP (8080)<br/>AE Onboarding &amp; Upstream Telemetry"| MOSQ
    MOSQ ===>|"Outbound mTLS 1.3 (8883)<br/>Downlink Actuation Commands"| ACT_MOD

