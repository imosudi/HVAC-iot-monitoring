      "m2m:grp": {
        "rn": "grp_fleet_telemetry",
        "ri": "grp_fleet_001",
        "ty": 9,
        "pi": "id-in",
        "mt": 3,
        "cnm": 2,
        "mnm": 1000,
        "mid": [
          "id-in/vehicle-001/raw-telemetry",
          "id-in/vehicle-002/raw-telemetry"
        ],
        "lbl": ["fleet", "telemetry", "sdv-cluster"]
      }
    }
  },
