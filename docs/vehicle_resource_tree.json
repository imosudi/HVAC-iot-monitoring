    {
      "m2m:ae": {
        "rn": "vehicle-002",
        "ri": "ae_v002",
        "ty": 2,
        "pi": "id-in",
        "api": "N.org.fhtw.sdv.cabin",
        "aei": "C_vehicle-002",
        "rr": true,
        "srv": ["2a", "3"],
        "lbl": ["vehicle", "car-002", "fleet-alpha"],
