      }
    },
    {
      "m2m:ae_template": {
        "description": "Onboarding pattern for vehicle-N",
        "pattern": "id-in/vehicle-{N}",
        "mandatory_containers": [
          "temperature-cabin",
          "humidity-cabin",
          "co2-cabin",
          "co-cabin",
          "air-quality-cabin",
          "air-quality-exterior",
          "raw-telemetry"
