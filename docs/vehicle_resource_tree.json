      "lt": "20261013T200000",
      "csi": "/id-in",
      "spid": "//acme.mioemi.com",
      "cst": 1,
      "srv": ["2a", "3", "4"],
      "poa": ["http://192.168.122.91:8080"]
    }
  },
  "fleet_management": {
    "access_control": {
      "m2m:acp": {
        "rn": "acp_fleet_manager",
        "ri": "acp_fleet_001",
        "ty": 1,
        "pi": "id-in",
        "pv": {
          "acr": [
