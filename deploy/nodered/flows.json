[
  {
    "id": "tab_sdv_ipe",
    "type": "tab",
    "label": "SDV oneM2M Ingress IPE",
    "disabled": false,
    "info": "Interworking Proxy Entity bridging MQTT telemetry to oneM2M REST primitives and dispatching downlink commands."
  },
  {
    "id": "mqtt_broker_config",
    "type": "mqtt-broker",
    "name": "Mosquitto mTLS Broker",
    "broker": "mosquitto",
    "port": "8883",
    "tls": "tls_config_mtls",
    "clientid": "nodered_ipe_gateway",
    "autoConnect": true,
    "usetls": true,
    "compatmode": false,
    "protocolVersion": "5",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true
  },
  {
    "id": "tls_config_mtls",
    "type": "tls-config",
    "name": "mTLS Certificate Bundle",
    "cert": "/data/certs/client_nodered.crt",
    "key": "/data/certs/client_nodered.key",
    "ca": "/data/certs/ca.crt",
    "certname": "client_nodered.crt",
    "keyname": "client_nodered.key",
    "caname": "ca.crt",
    "verifyservercert": true
  },
  {
    "id": "mqtt_in_telemetry",
    "type": "mqtt in",
    "z": "tab_sdv_ipe",
    "name": "Uplink Ingress (sdv/+/telemetry)",
    "topic": "sdv/+/telemetry",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt_broker_config",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 170,
    "y": 140,
    "wires": [["validate_and_format_cin"]]
  },
  {
    "id": "validate_and_format_cin",
    "type": "function",
    "z": "tab_sdv_ipe",
    "name": "Validate & Build oneM2M cin",
    "func": "// Extract topic tokens and payload\nconst payload = msg.payload;\nif (!payload || !payload.car_id || !payload.scd30) {\n    node.warn('Discarding invalid payload: Missing mandatory keys');\n    return null;\n}\n\n// Construct oneM2M ContentInstance representation\nconst cinBody = {\n    'm2m:cin': {\n        'cnf': 'application/json:0',\n        'con': JSON.stringify(payload)\n    }\n};\n\nmsg.headers = {\n    'X-M2M-Origin': 'CNodeRED_IPE',\n    'X-M2M-RI': 'req_' + Date.now(),\n    'Content-Type': 'application/json;ty=4',\n    'Accept': 'application/json'\n};\n\nmsg.url = 'http://onem2m_cse:8080/sdv-cse/AE_CabinNode_Car01/cnt_raw_telemetry';\nmsg.payload = cinBody;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 140,
    "wires": [["http_post_cin"]]
  },
  {
    "id": "http_post_cin",
    "type": "http request",
    "z": "tab_sdv_ipe",
    "name": "POST <cin> to /sdv-cse",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 750,
    "y": 140,
    "wires": [["log_cin_success"]]
  },
  {
    "id": "log_cin_success",
    "type": "debug",
    "z": "tab_sdv_ipe",
    "name": "oneM2M Ingress Result",
    "active": false,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 1010,
    "y": 140,
    "wires": []
  },
  {
    "id": "http_in_downlink",
    "type": "http in",
    "z": "tab_sdv_ipe",
    "name": "POST /downlink (Subscription Hook)",
    "url": "/downlink",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 200,
    "y": 280,
    "wires": [["parse_cmd_and_ack", "http_response_ack"]]
  },
  {
    "id": "http_response_ack",
    "type": "http response",
    "z": "tab_sdv_ipe",
    "name": "HTTP 200 ACK",
    "statusCode": "200",
    "headers": {},
    "x": 500,
    "y": 240,
    "wires": []
  },
  {
    "id": "parse_cmd_and_ack",
    "type": "function",
    "z": "tab_sdv_ipe",
    "name": "Parse oneM2M Command",
    "func": "const body = msg.payload;\nlet cmdPayload = null;\n\ntry {\n    const sgn = body['m2m:sgn'] || body;\n    const nev = sgn.nev || {};\n    const rep = nev.rep || {};\n    const cin = rep['m2m:cin'] || rep;\n    const con = cin.con;\n    cmdPayload = typeof con === 'string' ? JSON.parse(con) : con;\n} catch (e) {\n    node.error('Failed to parse command notification: ' + e.message);\n    return null;\n}\n\nif (!cmdPayload || cmdPayload.target_pwm === undefined) {\n    return null;\n}\n\nmsg.topic = 'sdv/vehicle_01/control/cmd';\nmsg.payload = cmdPayload;\nmsg.qos = 1;\nmsg.retain = false;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 510,
    "y": 320,
    "wires": [["mqtt_out_cmd"]]
  },
  {
    "id": "mqtt_out_cmd",
    "type": "mqtt out",
    "z": "tab_sdv_ipe",
    "name": "Downlink Egress (sdv/vehicle_01/control/cmd)",
    "topic": "sdv/vehicle_01/control/cmd",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "mqtt_broker_config",
    "x": 860,
    "y": 320,
    "wires": []
  }
]
