        {
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB_Flux"
          },
          "query": "from(bucket: \"cabin_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"cabin_environment\")\n  |> filter(fn: (r) => r[\"_field\"] == \"co2_ppm\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"co2\")",
          "refId": "A"
        }
      ],
      "title": "Cabin CO2 Concentration Trend",
      "type": "timeseries"
    },
